#!/bin/bash

DIR="${GITHUB_WORKSPACE:-$PWD}"

CONFIG_FILES=(
  .releaserc
  .releaserc.json
  .releaserc.yaml
  .releaserc.yml
  .releaserc.js
  .releaserc.cjs
  release.config.js
  release.config.cjs
)

has_config=false
for f in "${CONFIG_FILES[@]}"; do
  if [[ -f "${DIR}/${f}" ]]; then
    has_config=true
    break
  fi
done

# A `release` key in package.json is a config source too, and is easy to miss
# because there is no file to stat.
if [[ "${has_config}" == false ]] && [[ -f "${DIR}/package.json" ]]; then
  if node -e 'process.exit(require(process.argv[1]).release ? 0 : 1)' "${DIR}/package.json" 2>/dev/null; then
    has_config=true
  fi
fi

if [[ "${has_config}" == false ]]; then
  set -- "$@" --extends '@kubernetics/semantic-release-config'
fi

# Resolve semantic-release relative to this script rather than to a fixed path,
# so the wrapper works both inside the image (/opt/semantic-release/bin) and
# from an ordinary checkout on a CI runner (<repo>/bin). The repo releases
# itself with the latter, which is what keeps it from having to run inside the
# image it publishes.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

exec "${SCRIPT_DIR}/../node_modules/.bin/semantic-release" "$@"
