{
  "name": "@kubernetics/semantic-release-config",
  "version": "0.0.1",
  "description": "semantic-release shareable config",
  "dependencies": {
    "@codedependant/semantic-release-docker": "^8.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "conventional-commits-parser": "^6.0.0",
    "semantic-release": "^25.0.9",
    "semantic-release-helm3": "^2.10.0"
  },
  "devDependencies": {
    "xo": "0.47.0"
  },
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  },
  "files": [
    "index.js"
  ],
  "main": "index.js",
  "peerDependencies": {
    "semantic-release": ">=24.1.0"
  },
  "scripts": {
    "semantic-release": "semantic-release",
    "test": "xo",
    "lint": "xo"
  },
  "xo": {
    "prettier": true,
    "space": true,
    "rules": {
      "unicorn/string-content": "off",
      "unicorn/prefer-module": "off"
    }
  }
}
